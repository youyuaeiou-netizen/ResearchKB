# This file is safe to commit. Put real values only in the ignored .env.local file.
# FlClash is launched only when the executable is configured here.
OBSUI_FLCLASH_PATH=

# Clash Verge is launched only when the executable is configured here.
OBSUI_CLASH_VERGE_PATH=

# The local HTTP proxy used for automatic IPinfo updates. Loopback addresses only.
OBSUI_FLCLASH_PROXY_URL=http://127.0.0.1:7890

# Optional IPinfo Lite token for country and ASN enrichment. Without it,
# ObsUI still detects the public IP through ipify. Never use a VITE_ prefix.
OBSUI_IPINFO_TOKEN=

# Local literature/model integration. The model repository and literature
# database are fixed to C:\\AIModels and C:\\ObsUILiteratureDB.
# Leave blank to use the Ollama executable on PATH.
OBSUI_OLLAMA_PATH=

# Optional absolute path to pdftoppm.exe for scanned-PDF page rendering.
OBSUI_PDFTOPPM_PATH=
