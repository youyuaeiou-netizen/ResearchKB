# Knowledge, ObsUI source, and reviewed application state are synchronized.
# Credentials, machine configuration, dependencies, and generated files stay local.
**/.git/
**/node_modules/
**/dist/
**/.vite/
**/coverage/
**/__pycache__/
**/.pytest_cache/
**/*.py[cod]
**/.env
**/.env.*
**/*.env
!**/.env.example
!**/*.env.example
**/*.local
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/auth.json
